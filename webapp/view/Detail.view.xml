<mvc:View
    controllerName="com.nhpc.zhrsecaprf9s1.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
    class="sapUiSizeCompact"
>
    <App id="idReportApp">
        <pages>
            <Page
                id="idReportPage"
                showHeader="false"
            >
                <content>
                    <uxap:ObjectPageLayout
                        id="idReportObjectPageLayout"
                        upperCaseAnchorBar="false"
                    >
                        <uxap:headerTitle>
                            <uxap:ObjectPageDynamicHeaderTitle>
                                <uxap:expandedHeading>
                                    <HBox
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox class="sapUiTinyMarginBegin">
                                            <Title
                                                id="objPageHeader"
                                                text="{i18n>createDialogTitle}"
                                                wrapping="true"
                                            />
                                            <ObjectStatus
                                                title="{i18n>status}"
                                                text="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatTitleCase'}"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                        </VBox>
                                    </HBox>
                                </uxap:expandedHeading>
                                <uxap:snappedHeading>
                                    <HBox
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox class="sapUiTinyMarginBegin">
                                            <Title
                                                id="objPageHeader1"
                                                text="{i18n>createDialogTitle}"
                                                wrapping="true"
                                            />
                                            <ObjectStatus
                                                title="{i18n>status}"
                                                text="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatTitleCase'}"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/formDetails/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                        </VBox>
                                    </HBox>
                                </uxap:snappedHeading>
                                <uxap:actions>
                                    <Button
                                        text="{i18n>previewBtnText}"
                                        type="Emphasized"
                                        press="handlePreviewBtnPress"
                                        icon="sap-icon://show"
                                    />
                                </uxap:actions>
                            </uxap:ObjectPageDynamicHeaderTitle>
                        </uxap:headerTitle>
                        <uxap:sections>
                        <uxap:ObjectPageSection
                                title="{i18n>employeeDetails}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrsecaprf9s1.fragment.EmployeeDetails"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                title="{i18n>transactionHoldings}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrsecaprf9s1.fragment.TransactionHoldings"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                title="{i18n>transactionRelatives}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrsecaprf9s1.fragment.TransactionRelatives"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>   
                            <uxap:ObjectPageSection
                                title="{i18n>historyRemarks}"
                                titleUppercase="false"
                                visible ="{= ${viewModel>/formDetails/Status} === 'Returned' || ${viewModel>/formDetails/Status} === 'Confirmed' || ${viewModel>/formDetails/Status} === 'Approved'}"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection>
                                        <uxap:blocks>
                                            <VBox>
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zhrsecaprf9s1.fragment.HistoryRemarks"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>                     
                        </uxap:sections>
                    </uxap:ObjectPageLayout>
                </content>
                <footer>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            text="{i18n>approveBtnText}"
                            type="Accept"
                            press="handleApproveBtnPress"
                            icon="sap-icon://accept"
                            visible="{= ${viewModel>/formDetails/Status} !== 'Approved'}"
                        />
                        <Button
                            text="{i18n>returnBtnText}"
                            type="Critical"
                            press="handleReturnBtnPress"
                            icon="sap-icon://undo"
                            visible="{= ${viewModel>/formDetails/Status} !== 'Approved'}"
                        />
                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>
