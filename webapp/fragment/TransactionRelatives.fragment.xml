<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    class="sapUiSizeCompact"
>
    <VBox>
        <Toolbar>
            <Title
                text="{= ${i18n>transactionRelatives} + ' (' + ${viewModel>/TransactionRelativesLength} + ')' }"
            />
            <ToolbarSpacer />
            <Button
                text="{i18n>addBtnText}"
                icon="sap-icon://add"
                type="Accept"
                press="onAddSecurityDetailsRelatives"
                visible="{= ${viewModel>/formDetails/Status} === 'New' || ${viewModel>/formDetails/Status} === 'Draft' || ${viewModel>/formDetails/Status} === 'Returned'}"
            />
            <Button
                text="{i18n>deleteBtnText}"
                icon="sap-icon://delete"
                type="Reject"
                press="onDeleteSecurityDetailsRelatives"
                visible="{= ${viewModel>/formDetails/Status} === 'New' || ${viewModel>/formDetails/Status} === 'Draft' || ${viewModel>/formDetails/Status} === 'Returned'}"
            />
            <Button
                text="{i18n>editBtnText}"
                icon="sap-icon://edit"
                type="Emphasized"
                press="onEditSecurityDetailsRelatives"
                visible="{= ${viewModel>/formDetails/Status} === 'New' || ${viewModel>/formDetails/Status} === 'Draft' || ${viewModel>/formDetails/Status} === 'Returned'}"
            />
        </Toolbar>
        <table:Table
            id="idTransactionRelativeTable"
            rows="{viewModel>/TransactionRelatives}"
            fixedColumnCount="1"
            selectionMode="{= ${viewModel>/formDetails/Status} !== 'Approved' &amp;&amp; ${viewModel>/formDetails/Status} !== 'Confirmed' ? 'Single' : 'None'}"
            selectionBehavior="Row"
            alternateRowColors="true"
            width="100%"
            rowsUpdated="onTransactionRelativeTableUpdateFinish"
        >
            <table:rowMode>
                <rowmodes:Fixed
                    rowCount="{= ${viewModel>/TransactionRelativesLength} >= 2 ? 2 : 1}"
                    rowContentHeight="45"
                />
            </table:rowMode>
            <table:columns>
                <table:Column width="180px">
                    <Text text="{i18n>natureOfSecurity}" />
                    <table:template>
                        <Text text="{viewModel>NatureOfSecurity}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Relativename}" />
                    <table:template>
                        <Text text="{viewModel>Relativename}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Relativetype}" />
                    <table:template>
                        <Text text="{viewModel>Relativetype}" />
                    </table:template>
                </table:Column>
                <table:Column width="160px">
                    <Text text="{i18n>Others}" />
                    <table:template>
                        <Text text="{viewModel>Others}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Noofsecuritiesprev}" />
                    <table:template>
                        <Text text="{viewModel>Noofsecuritiesprev}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>securityPurchased}" />
                    <table:template>
                        <Text text="{viewModel>TransactionType}" />
                    </table:template>
                </table:Column>
                <table:Column width="220px">
                    <Text
                        text="{= ${i18n>Noofsecuritiesheld} + ' ' + ${viewModel>/todayDate} }"
                    />
                    <table:template>
                        <Text text="{viewModel>Noofsecuritiesheld}" />
                    </table:template>
                </table:Column>
                <table:Column width="160px">
                    <Text text="{i18n>Dpclientid}" />
                    <table:template>
                        <Text text="{viewModel>Dpclientid}" />
                    </table:template>
                </table:Column>
                <table:Column width="160px">
                    <Text text="{i18n>Transactiondate}" />
                    <table:template>
                        <Text
                            text="{path:'viewModel>Transactiondate',formatter:'.formatter.formatDate'}"
                        />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Securitypurchased}" />
                    <table:template>
                        <Text text="{viewModel>Securitypurchased}" />
                    </table:template>
                </table:Column>
                <table:Column width="180px">
                    <Text text="{i18n>Securitysold}" />
                    <table:template>
                        <Text text="{viewModel>Securitysold}" />
                    </table:template>
                </table:Column>
                <table:Column width="220px">
                    <Text text="{i18n>SecuritypurchasedConsideration}" />
                    <table:template>
                        <Text text="{viewModel>Securitypurchasedconso}" />
                    </table:template>
                </table:Column>
                <table:Column width="220px">
                    <Text text="{i18n>SecuritysoldConsideration}" />
                    <table:template>
                        <Text text="{viewModel>Securitysoldconso}" />
                    </table:template>
                </table:Column>
                <table:Column width="150px">
                    <Text text="{i18n>Offmarket}" />
                    <table:template>
                        <Text text="{viewModel>Offmarket}" />
                    </table:template>
                </table:Column>
            </table:columns>
        </table:Table>
    </VBox>
</core:FragmentDefinition>
