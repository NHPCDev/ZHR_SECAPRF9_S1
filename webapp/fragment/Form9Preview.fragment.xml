<c:FragmentDefinition
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
    class="sapUiSizeCompact"
>
    <Dialog
        title="{i18n>form9Preview}"
        class="sapUiSizeCompact"
        horizontalScrolling="false"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <Title
                    text="{i18n>form9}"
                    class="blueTitle"
                />
                <Title
                    text="{i18n>preforma}"
                    textAlign="Center"
                    class="sapUiSmallMargin blueTitle"
                />
                <!-- Start of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                <FormattedText
                    htmlText="{
        parts: [
            { path: 'viewModel>/formDetails/Fromdate' },
            { path: 'viewModel>/formDetails/Todate' },
            {path:'viewModel>/formDetails/HeaderText'}
        ],
        formatter: '.formatter.formatName'
    }"
                    class="sapUiSmallMargin"
                />
                <!-- End of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                <form:SimpleForm
                    class="sapUiSmallMargin"
                >
                    <Label text="{i18n>employeeIdLabel}" />
                    <Text
                        text="{path: 'viewModel>/formDetails/EmployeeId', formatter: '.formatter.formatBlankValue'}"
                    />
                    <Label text="{i18n>employeeNameLabel}" />
                    <Text
                        text="{path: 'viewModel>/formDetails/EmployeeName', formatter: '.formatter.formatBlankValue'}"
                    />
                    <Label text="{i18n>designationLabel}" />
                    <Text
                        text="{path: 'viewModel>/formDetails/Designation', formatter: '.formatter.formatBlankValue'}"
                    />
                    <Label text="{i18n>departmentLabel}" />
                    <Text
                        text="{path: 'viewModel>/formDetails/EmployeeDepartment', formatter: '.formatter.formatBlankValue'}"
                    />
                    <Label text="{i18n>dateOfJoiningLabel}" />
                    <Text
                        text="{path: 'viewModel>/formDetails/DateOfJoining', formatter: '.formatter.formatDate'}"
                        width="10rem"
                    />
                </form:SimpleForm>
                <Title
                    text="{i18n>table1header}"
                    class="sapUiSmallMarginTop"
                />
                <table:Table
                    id="idTransactionHoldingTable1"
                    xmlns:table="sap.ui.table"
                    xmlns:rowmodes="sap.ui.table.rowmodes"
                    rows="{viewModel>/TransactionHolding}"
                    selectionMode="None"
                    selectionBehavior="Row"
                    alternateRowColors="true"
                    width="100%"
                    fixedColumnCount="1"
                    rowsUpdated="onTransactionHoldingTableUpdateFinish"
                    class="sapUiSmallMargin"
                >
                    <table:rowMode>
                        <rowmodes:Fixed
                            rowCount="{= ${viewModel>/TransactionHoldingLength} >= 2 ? 2 : 1}"
                            rowContentHeight="45"
                        />
                    </table:rowMode>
                    <table:columns>
                        <table:Column width="180px">
                            <Text text="{i18n>natureOfSecurity}" />
                            <table:template>
                                <Text text="{viewModel>NatureOfSecurity}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Noofsecuritiesprev}" />
                            <table:template>
                                <Text text="{viewModel>Noofsecuritiesprev}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>securityPurchased}" />
                            <table:template>
                                <Text text="{viewModel>TransactionType}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Text
                                text="{= ${i18n>Noofsecuritiesheld} + ' ' + ${viewModel>/todayDate} }"
                            />
                            <table:template>
                                <Text text="{viewModel>Noofsecuritiesheld}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="160px">
                            <Text text="{i18n>Dpclientid}" />
                            <table:template>
                                <Text text="{viewModel>Dpclientid}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="160px">
                            <Text text="{i18n>Transactiondate}" />
                            <table:template>
                                <Text
                                    text="{path:'viewModel>Transactiondate',formatter:'.formatter.formatDate'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Securitypurchased}" />
                            <table:template>
                                <Text text="{viewModel>Securitypurchased}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Securitysold}" />
                            <table:template>
                                <Text text="{viewModel>Securitysold}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Text
                                text="{i18n>SecuritypurchasedConsideration}"
                            />
                            <table:template>
                            <!-- Start of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                                <Text
                                    text="{path:'viewModel>Securitypurchasedconso',formatter:'.formatter.formatAmountToINR'}"
                                />
                                <!-- End of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Text text="{i18n>SecuritysoldConsideration}" />
                            <table:template>
                            <!-- Start of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                                <Text text="{path:'viewModel>Securitysoldconso',formatter:'.formatter.formatAmountToINR'}" />
                                <!-- End of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                            </table:template>
                        </table:Column>
                        <table:Column width="150px">
                            <Text text="{i18n>Offmarket}" />
                            <table:template>
                                <Text text="{viewModel>Offmarket}" />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
                <Title
                    text="{i18n>table2data}"
                    class="sapUiSmallMarginTop"
                />
                <table:Table
                    id="idTransactionRelativeTable1"
                    xmlns:table="sap.ui.table"
                    xmlns:rowmodes="sap.ui.table.rowmodes"
                    rows="{viewModel>/TransactionRelatives}"
                    fixedColumnCount="1"
                    selectionMode="None"
                    selectionBehavior="Row"
                    alternateRowColors="true"
                    width="100%"
                    rowsUpdated="onTransactionRelativeTableUpdateFinish"
                    class="sapUiSmallMargin"
                >
                    <table:rowMode>
                        <rowmodes:Fixed
                            rowCount="{= ${viewModel>/TransactionRelativesLength} >= 2 ? 2 : 1}"
                            rowContentHeight="45"
                        />
                    </table:rowMode>
                    <table:columns>
                        <table:Column width="180px">
                            <Text text="{i18n>natureOfSecurity}" />
                            <table:template>
                                <Text text="{viewModel>NatureOfSecurity}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Relativename}" />
                            <table:template>
                                <Text text="{viewModel>Relativename}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Relativetype}" />
                            <table:template>
                                <Text text="{viewModel>Relativetype}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="160px">
                            <Text text="{i18n>Others}" />
                            <table:template>
                                <Text text="{viewModel>Others}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Noofsecuritiesprev}" />
                            <table:template>
                                <Text text="{viewModel>Noofsecuritiesprev}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>securityPurchased}" />
                            <table:template>
                                <Text text="{viewModel>TransactionType}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Text
                                text="{= ${i18n>Noofsecuritiesheld} + ' ' + ${viewModel>/todayDate} }"
                            />
                            <table:template>
                                <Text text="{viewModel>Noofsecuritiesheld}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="160px">
                            <Text text="{i18n>Dpclientid}" />
                            <table:template>
                                <Text text="{viewModel>Dpclientid}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="160px">
                            <Text text="{i18n>Transactiondate}" />
                            <table:template>
                                <Text
                                    text="{path:'viewModel>Transactiondate',formatter:'.formatter.formatDate'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Securitypurchased}" />
                            <table:template>
                                <Text text="{viewModel>Securitypurchased}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Text text="{i18n>Securitysold}" />
                            <table:template>
                                <Text text="{viewModel>Securitysold}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Text
                                text="{i18n>SecuritypurchasedConsideration}"
                            />
                            <table:template>
                            <!-- Start of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                                <Text
                                    text="{path:'viewModel>Securitypurchasedconso',formatter:'.formatter.formatAmountToINR'}"
                                />
                                <!-- End of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Text text="{i18n>SecuritysoldConsideration}" />
                            <table:template>
                            <!-- Start of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                                <Text text="{path:'viewModel>Securitysoldconso',formatter:'.formatter.formatAmountToINR'}" />
                                <!-- End of Change: 06.11.2026: Balamurugan : Declaration added and total value label change -->
                            </table:template>
                        </table:Column>
                        <table:Column width="150px">
                            <Text text="{i18n>Offmarket}" />
                            <table:template>
                                <Text text="{viewModel>Offmarket}" />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
                <FormattedText
                    htmlText="{path:'viewModel>/formDetails/UndertakingText',
        formatter:'.formatter.formatterUndertakingText'}"
                    class="sapUiSmallMargin"
                />
            </VBox>
        </content>
        <endButton>
            <Button
                text="{i18n>cancelBtnText}"
                press="onForm9PreviewCancel"
            />
        </endButton>
    </Dialog>
</c:FragmentDefinition>
